# Spring Mouse 环境变量模板
#
# 复制为 .env 后，至少替换所有 `change-me` 的敏感值；不要把真实密钥提交到仓库。
# Docker Compose 的默认生产端口为 8008，数据目录为容器内的 /app/data。

# -----------------------------------------------------------------------------
# 运行环境
# -----------------------------------------------------------------------------
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=8008
DATA_DIR=/app/data

# -----------------------------------------------------------------------------
# 必填安全配置
# -----------------------------------------------------------------------------
# 用于仪表盘登录会话签名：请使用足够长的随机字符串。
JWT_SECRET=change-me-to-a-long-random-secret
# 首次启动时的仪表盘管理员密码。完成初始化后可在页面中修改。
INITIAL_PASSWORD=change-me
# API Key 的稳定派生密钥。生产环境必须替换，之后不要随意更改。
API_KEY_SECRET=change-me-to-a-long-random-api-key-secret
# 本机标识加盐。生产环境必须替换，之后不要随意更改。
MACHINE_ID_SALT=change-me-to-a-long-random-machine-id-salt

# -----------------------------------------------------------------------------
# 服务地址与 Cookie
# -----------------------------------------------------------------------------
# 当前 Spring Mouse 实例可访问的地址；生产环境请改为实际域名（例如 https://mouse.example.com）。
BASE_URL=http://localhost:8008
NEXT_PUBLIC_BASE_URL=http://localhost:8008
# HTTPS 反向代理后建议设为 true；本地 HTTP 调试保持 false。
AUTH_COOKIE_SECURE=false

# 可选：云同步服务地址。未使用云同步时保持注释；不要填写旧项目地址。
# CLOUD_URL=https://cloud.example.com
# NEXT_PUBLIC_CLOUD_URL=https://cloud.example.com

# -----------------------------------------------------------------------------
# 请求记录、可观测性与日志
# -----------------------------------------------------------------------------
# 完整请求/响应文件日志的首次启动默认值；之后可在 Dashboard 设置页随时开关。
# 开启后会写入 DATA_DIR/request-logs 并可能快速占用磁盘，仅建议排障时临时使用。
ENABLE_REQUEST_LOG_FILE_DUMPS=false
# 可选：请求日志文件目录；默认写入 DATA_DIR/request-logs。
# REQUEST_LOGS_DIR=/app/data/request-logs
# 是否启用聚合可观测性数据；设为 false 可完全关闭。
OBSERVABILITY_ENABLED=true
# usageHistory / networkTraffic 的保留天数。这两张表按请求增长（约 3 万行/天），
# 超期数据由 usage-writer 进程分块清理。
# 该值现在可在 Dashboard「个人设置 → 数据保留」中配置，设置页的值优先；
# 这里的环境变量仅作为兜底（设置项缺失或读取失败时使用）。默认 90；设为 0 表示永久保留。
# 注意：调小该值会删除长周期（60d/all）视图所需的历史明细。
SPRING_MOUSE_USAGE_RETENTION_DAYS=90
# 可选：清理检查间隔（毫秒），默认每小时一次。
# SPRING_MOUSE_USAGE_PRUNE_INTERVAL_MS=3600000
# 可选：单次删除的行数上限，默认 5000；调小可进一步降低与写入的争用。
# SPRING_MOUSE_USAGE_PRUNE_CHUNK=5000
# 可选：聚合 worker 线程池大小（默认 2）。聚合在 worker 中执行以避免阻塞事件循环；
# 每个 worker 持有一条只读 SQLite 连接，内存紧张时可设为 1。
# SPRING_MOUSE_USAGE_WORKER_POOL=2
# 可选：DEBUG、INFO、WARN 或 ERROR；默认 WARN。
LOG_LEVEL=WARN
# Docker stdout/stderr 日志轮转；修改后需重新创建容器。
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=3
# 可选：要求 OpenAI 兼容接口携带 API Key。
REQUIRE_API_KEY=false

# -----------------------------------------------------------------------------
# Cloudflare 真实客户端 IP
# -----------------------------------------------------------------------------
# 内置 cloudflared Tunnel 会通过本机 /ready 端点确认已连接 Cloudflare Edge 后，
# 才采用 CF-Connecting-IP；Pseudo IPv4 覆盖模式下会采用 CF-Connecting-IPv6。
# readiness/metrics 仅监听本机。端口被占用时可修改，但应用和 cloudflared 必须一致。
CLOUDFLARED_METRICS_PORT=20241

# -----------------------------------------------------------------------------
# 其他反向代理与真实客户端 IP
# -----------------------------------------------------------------------------
# 同机代理（127.0.0.1 / ::1）默认已受信任，无需配置。
# 如果代理与 Spring Mouse 不在同一网络命名空间（例如 Docker bridge 或独立服务器），
# 必须设置其 TCP 对端 IP 或 IPv4 CIDR，才能信任其 X-Real-IP / X-Forwarded-For 并记录真实客户端 IP。
# 多个值用英文逗号分隔。仅填写实际代理地址，切勿放开任意内网或公网网段。
# Docker 默认 bridge 示例：TRUSTED_PROXY_IPS=172.17.0.1
# 自定义 Docker 网络示例：TRUSTED_PROXY_IPS=172.18.0.0/16
# 独立 Nginx 示例：TRUSTED_PROXY_IPS=10.10.0.15
TRUSTED_PROXY_IPS=

# Nginx 应同时向上游透传真实客户端地址：
# proxy_set_header X-Real-IP $remote_addr;
# proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

# -----------------------------------------------------------------------------
# GeoIP 地理位置识别（可选）
# -----------------------------------------------------------------------------
# 将 MaxMind GeoLite2 数据库映射到 /app/data/geoip，例如：
#   GeoLite2-City.mmdb：国家 / 省份 / 城市 / 时区
#   GeoLite2-ASN.mmdb：可选，ASN / 网络组织
GEOIP_DATA_DIR=/app/data/geoip
GEOIP_CITY_PATH=/app/data/geoip/GeoLite2-City.mmdb
GEOIP_ASN_PATH=/app/data/geoip/GeoLite2-ASN.mmdb

# -----------------------------------------------------------------------------
# 可选集成
# -----------------------------------------------------------------------------
# 运行内置反检测浏览器服务时的地址；docker-compose.yml 默认提供该服务。
# HEADROOM_URL=http://headroom:8787
# 内置 Web Search 使用的 SearXNG 搜索端点。
# SEARXNG_URL=http://searxng:8080/search
# 关闭服务 API 所需的额外密钥；不配置时该 API 不可用。
# SHUTDOWN_SECRET=change-me-to-a-long-random-shutdown-secret

# -----------------------------------------------------------------------------
# 可选：上游网络代理
# -----------------------------------------------------------------------------
# 应用调用模型供应商时使用的代理。小写变量也兼容。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# Docker image used by docker-compose.yml. Pin a release tag in production.
SPRING_MOUSE_IMAGE=choarkinphe/spring-mouse:latest

# Optional Google OAuth clients for Gemini and Antigravity providers.
# Create your own OAuth clients; never commit their values.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Redis-backed routing hot path. The embedded Docker Redis is configured automatically.
# Soft scheduling hints, NOT upstream hard caps or admission control.
# Override the concurrency hint according to measured per-account capacity.
# SPRING_MOUSE_CONNECTION_MAX_CONCURRENCY=16
# Renewable request leases; expired crashed-worker leases are reclaimed independently.
# SPRING_MOUSE_CONNECTION_SLOT_TTL_SECONDS=90
# Best-effort routing/hot-cache operations only; durable usage queue is unchanged.
# SPRING_MOUSE_ROUTING_REDIS_TIMEOUT_MS=200
