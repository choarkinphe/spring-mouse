# Spring Mouse 环境变量模板
#
# 复制为 .env 后，至少替换所有 `change-me` 的敏感值；不要把真实密钥提交到仓库。
# Docker Compose 的默认生产端口为 8008，数据目录为容器内的 /app/data。

# -----------------------------------------------------------------------------
# 运行环境
# -----------------------------------------------------------------------------
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=8008
DATA_DIR=/app/data

# -----------------------------------------------------------------------------
# 必填安全配置
# -----------------------------------------------------------------------------
# 用于仪表盘登录会话签名：请使用足够长的随机字符串。
JWT_SECRET=change-me-to-a-long-random-secret
# 首次启动时的仪表盘管理员密码。完成初始化后可在页面中修改。
INITIAL_PASSWORD=change-me
# API Key 的稳定派生密钥。生产环境必须替换，之后不要随意更改。
API_KEY_SECRET=change-me-to-a-long-random-api-key-secret
# 本机标识加盐。生产环境必须替换，之后不要随意更改。
MACHINE_ID_SALT=change-me-to-a-long-random-machine-id-salt

# -----------------------------------------------------------------------------
# 服务地址与 Cookie
# -----------------------------------------------------------------------------
# 当前 Spring Mouse 实例可访问的地址；生产环境请改为实际域名（例如 https://mouse.example.com）。
BASE_URL=http://localhost:8008
NEXT_PUBLIC_BASE_URL=http://localhost:8008
# HTTPS 反向代理后建议设为 true；本地 HTTP 调试保持 false。
AUTH_COOKIE_SECURE=false

# 可选：云同步服务地址。未使用云同步时保持注释；不要填写旧项目地址。
# CLOUD_URL=https://cloud.example.com
# NEXT_PUBLIC_CLOUD_URL=https://cloud.example.com

# -----------------------------------------------------------------------------
# 请求记录、可观测性与日志
# -----------------------------------------------------------------------------
# 是否写入请求明细（包含来源 IP、用户代理、模型与 Token 等）。
ENABLE_REQUEST_LOGS=true
# 是否启用聚合可观测性数据；设为 false 可完全关闭。
OBSERVABILITY_ENABLED=true
# 可选：DEBUG、INFO、WARN 或 ERROR；默认 INFO。
LOG_LEVEL=INFO
# 可选：要求 OpenAI 兼容接口携带 API Key。
REQUIRE_API_KEY=false

# -----------------------------------------------------------------------------
# 反向代理与真实客户端 IP
# -----------------------------------------------------------------------------
# 同机 Nginx（127.0.0.1 / ::1）默认已受信任，无需配置。
# 如果 Nginx 与 Spring Mouse 不在同一网络命名空间（例如 Docker bridge 或独立服务器），
# 必须设置其 TCP 对端 IP 或 IPv4 CIDR，才能信任其 X-Real-IP / X-Forwarded-For 并记录真实客户端 IP。
# 多个值用英文逗号分隔。仅填写实际反向代理地址，切勿放开任意内网或公网网段。
# Docker 默认 bridge 示例：TRUSTED_PROXY_IPS=172.17.0.1
# 自定义 Docker 网络示例：TRUSTED_PROXY_IPS=172.18.0.0/16
# 独立 Nginx 示例：TRUSTED_PROXY_IPS=10.10.0.15
TRUSTED_PROXY_IPS=

# Nginx 应同时向上游透传真实客户端地址：
# proxy_set_header X-Real-IP $remote_addr;
# proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

# -----------------------------------------------------------------------------
# GeoIP 地理位置识别（可选）
# -----------------------------------------------------------------------------
# 将 MaxMind GeoLite2 数据库映射到 /app/data/geoip，例如：
#   GeoLite2-City.mmdb：国家 / 省份 / 城市 / 时区
#   GeoLite2-ASN.mmdb：可选，ASN / 网络组织
GEOIP_DATA_DIR=/app/data/geoip
GEOIP_CITY_PATH=/app/data/geoip/GeoLite2-City.mmdb
GEOIP_ASN_PATH=/app/data/geoip/GeoLite2-ASN.mmdb

# -----------------------------------------------------------------------------
# 可选集成
# -----------------------------------------------------------------------------
# 运行内置反检测浏览器服务时的地址；docker-compose.yml 默认提供该服务。
# HEADROOM_URL=http://headroom:8787
# 内置 Web Search 使用的 SearXNG 搜索端点。
# SEARXNG_URL=http://searxng:8080/search
# 关闭服务 API 所需的额外密钥；不配置时该 API 不可用。
# SHUTDOWN_SECRET=change-me-to-a-long-random-shutdown-secret

# -----------------------------------------------------------------------------
# 可选：上游网络代理
# -----------------------------------------------------------------------------
# 应用调用模型供应商时使用的代理。小写变量也兼容。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# Docker image used by docker-compose.yml. Pin a release tag in production.
SPRING_MOUSE_IMAGE=choarkinphe/spring-mouse:latest

# Optional Google OAuth clients for Gemini and Antigravity providers.
# Create your own OAuth clients; never commit their values.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
