# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:22-alpine

FROM ${NODE_IMAGE}

WORKDIR /app

COPY --chown=node:node mouse/agent.mjs ./mouse/agent.mjs

ENV NODE_ENV=production \
    MOUSE_HOST=0.0.0.0 \
    MOUSE_PORT=9101 \
    MOUSE_STATE_FILE=/data/agent.json

RUN mkdir -p /data && chown node:node /data

USER node

VOLUME ["/data"]

EXPOSE 9101

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
  CMD ["sh", "-c", "wget -qO- http://127.0.0.1:${MOUSE_PORT:-9101}/healthz >/dev/null 2>&1"]

ENTRYPOINT ["node", "/app/mouse/agent.mjs"]
